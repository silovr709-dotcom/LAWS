---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { documents, type LegalDocument } from '../../../data/documents';
import { site } from '../../../data/site';
import { canonicalUrl, withBase } from '../../../lib/paths';
import { breadcrumbs } from '../../../lib/schema';
import { getCollection } from 'astro:content';
import { articleDocuments } from '../../../data/links';

export async function getStaticPaths() {
  return documents.map((document) => ({
    params: { slug: document.slug },
    props: { document },
  }));
}

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
const title = `${document.title} — образец документа · адвокат Юрий Кочевинов`;
const description = document.summary;

const peer = documents.filter((item) => item.group === document.group && item.slug !== document.slug).slice(0, 3);
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const relatedArticles = allArticles
  .filter((article) => (articleDocuments[article.id] ?? []).includes(document.slug))
  .slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'DigitalDocument',
  name: document.title,
  description: document.summary,
  url: canonicalUrl(site.url, `/materialy/obrazcy/${document.slug}/`),
  encodingFormat: 'application/pdf',
  inLanguage: 'ru-RU',
  about: document.basis,
  author: { '@type': 'Person', name: site.fullName, jobTitle: 'Адвокат' },
};
---

<BaseLayout title={title} description={description} type="article" schema={[schema, breadcrumbs([{ name: 'Главная', path: '/' }, { name: 'Материалы', path: '/materialy/' }, { name: 'Образцы документов', path: '/materialy/obrazcy/' }, { name: document.short, path: `/materialy/obrazcy/${document.slug}/` }])]}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href={withBase('/')}>Главная</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/materialy/')}>Материалы</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/materialy/obrazcy/')}>Образцы документов</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{document.short}</span>
      </nav>
      <p class="eyebrow">{document.group}</p>
      <h1 class="page-hero__title">{document.title}</h1>
      <p class="page-hero__lead">{document.summary}</p>
      <div class="doc-actions">
        <a
          class="btn btn--primary"
          href={withBase(`/documents/${document.slug}.pdf`)}
          download
          data-goal="document_download"
        >
          Скачать PDF
          <Icon name="arrow-right" size={15} />
        </a>
        <button class="btn btn--outline-light" type="button" data-print>Распечатать</button>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container doc-layout">
      <div class="doc-main">
        <dl class="doc-meta">
          <div>
            <dt>Правовая основа</dt>
            <dd>{document.basis}</dd>
          </div>
          <div>
            <dt>Куда подаётся</dt>
            <dd>{document.addressee}</dd>
          </div>
          <div>
            <dt>Срок</dt>
            <dd>{document.deadline}</dd>
          </div>
        </dl>

        <article class="doc-sheet">
          <div class="doc-sheet__brand">
            <span>Адвокат Юрий Кочевинов · реестровый номер {site.registryNumber}</span>
            <span>Образец документа</span>
          </div>
          <div class="doc-sheet__header">
            {document.header.map((line) => <div>{line}</div>)}
          </div>
          <h2 class="doc-sheet__heading">{document.heading}</h2>
          <p class="doc-sheet__subhead">{document.subheading}</p>

          {
            document.blocks.map((block) => {
              if ('h' in block) return <h3 class="doc-sheet__sub">{block.h}</h3>;
              if ('p' in block) return <p>{block.p}</p>;
              if ('ul' in block)
                return (
                  <ul>
                    {block.ul.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                );
              return <p class="doc-sheet__note">{block.note}</p>;
            })
          }

          <h3 class="doc-sheet__sub">Приложение</h3>
          <ol class="doc-sheet__appendix">
            {document.appendix.map((item) => <li>{item}</li>)}
          </ol>

          <div class="doc-sheet__closing">
            <span>{document.closing}</span>
            <span>«____» ____________ 20____ г.</span>
          </div>

          <p class="doc-sheet__rule">
            Образец носит информационный характер, не является юридической консультацией и требует
            адаптации к обстоятельствам дела. Правовая основа: {document.basis}.
          </p>
        </article>
      </div>

      <aside class="doc-aside">
        <div class="aside-card">
          <h2>Перед подачей</h2>
          <ul class="doc-aside__list">
            <li>Проверьте адресата и подсудность — от этого зависит, примут ли документ.</li>
            <li>Приложите копии по числу участников процесса.</li>
            <li>Соблюдите срок: у жалоб он короткий.</li>
            <li>Не отправляйте документы и подробности дела через открытые каналы.</li>
          </ul>
          <p style="margin-top:14px;">
            <a class="btn btn--primary" href={withBase('/#kontakty')}>Обсудить ситуацию</a>
          </p>
        </div>

        {relatedArticles.length > 0 && (
          <div class="aside-card doc-aside__related">
            <h2>Как это применяется</h2>
            <ul class="doc-aside__links">
              {relatedArticles.map((article) => (
                <li>
                  <a href={withBase(`/materialy/razbory/${article.id}/`)}>
                    {article.data.title}
                    <Icon name="arrow-right" size={13} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {
          peer.length > 0 && (
            <div class="aside-card doc-aside__related">
              <h2>По этой же теме</h2>
              <ul class="doc-aside__links">
                {peer.map((item) => (
                  <li>
                    <a href={withBase(`/materialy/obrazcy/${item.slug}/`)}>
                      {item.short}
                      <Icon name="arrow-right" size={13} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </section>
  <script>
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  </script>

  <style>
    .doc-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: clamp(1.4rem, 3vw, 2rem);
    }

    .doc-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: clamp(28px, 4vw, 56px);
      align-items: start;
    }

    .doc-meta {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin: 0 0 clamp(24px, 4vw, 36px);
      padding-bottom: 22px;
      border-bottom: 1px solid var(--line);
    }

    .doc-meta dt {
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .doc-meta dd {
      margin: 0;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .doc-sheet {
      overflow-wrap: anywhere;
      background: #fff;
      border: 1px solid var(--line);
      padding: clamp(16px, 4vw, 44px);
      box-shadow: 0 18px 40px -32px rgba(53, 18, 29, 0.4);
      font-size: 0.95rem;
      line-height: 1.62;
    }

    .doc-sheet__brand {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
      padding-bottom: 10px;
      margin-bottom: 22px;
      border-bottom: 1px solid var(--wine, #7a1f33);
      font-size: 0.66rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--wine, #7a1f33);
    }

    .doc-sheet__header {
      margin-bottom: 20px;
      font-size: 0.9rem;
    }

    .doc-sheet__header div,
    .doc-meta dd,
    .doc-sheet__closing span {
      overflow-wrap: anywhere;
    }

    .doc-sheet__heading {
      font-size: 1.15rem;
      letter-spacing: 0.06em;
      text-align: center;
      margin-bottom: 4px;
      font-family: var(--font-body);
      font-weight: 600;
    }

    .doc-sheet__subhead {
      text-align: center;
      font-size: 0.9rem;
      color: var(--muted);
      margin-bottom: 22px;
    }

    .doc-sheet__sub {
      font-family: var(--font-body);
      font-size: 1rem;
      font-weight: 600;
      margin: 20px 0 8px;
    }

    .doc-sheet p {
      margin: 0 0 10px;
      overflow-wrap: anywhere;
    }

    .doc-sheet ul,
    .doc-sheet__appendix {
      margin: 0 0 12px;
      padding-left: 20px;
    }

    .doc-sheet li {
      margin-bottom: 5px;
      overflow-wrap: anywhere;
    }

    .doc-sheet__note {
      font-size: 0.84rem;
      color: var(--muted);
      border-left: 2px solid var(--sand, #d8cbb2);
      padding-left: 12px;
    }

    .doc-sheet__closing {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 12px;
      margin-top: 28px;
      font-size: 0.9rem;
    }

    .doc-sheet__rule {
      margin-top: 26px;
      padding-top: 10px;
      border-top: 1px solid var(--line);
      font-size: 0.72rem;
      color: var(--muted);
      line-height: 1.5;
    }

    .doc-aside {
      display: grid;
      gap: 18px;
      position: sticky;
      top: 92px;
    }

    .doc-aside__list {
      margin: 0;
      padding-left: 18px;
      font-size: 0.86rem;
      line-height: 1.55;
      color: var(--muted);
    }

    .doc-aside__list li {
      margin-bottom: 8px;
    }

    .doc-aside__links {
      list-style: none;
      margin: 0;
      padding: 0;
      font-size: 0.87rem;
    }

    .doc-aside__links li + li {
      border-top: 1px solid var(--line);
    }

    .doc-aside__links a {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 0;
      color: inherit;
    }

    @media (max-width: 1024px) {
      .doc-layout {
        grid-template-columns: minmax(0, 1fr);
      }

      .doc-aside {
        position: static;
      }

      .doc-meta {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media print {
      :global(.site-header),
      :global(.site-footer),
      .doc-aside,
      :global(.breadcrumbs),
      .doc-actions,
      :global(.mobile-call-bar) {
        display: none !important;
      }

      .doc-sheet {
        border: none;
        box-shadow: none;
        padding: 0;
      }
    }
  </style>
</BaseLayout>
