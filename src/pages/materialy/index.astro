---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ContactPrompt from '../../components/ContactPrompt.astro';
import { documents, documentGroupsWithCount } from '../../data/documents';
import { formatDate, plural } from '../../lib/format';
import { site } from '../../data/site';
import { canonicalUrl, withBase } from '../../lib/paths';
import { breadcrumbs } from '../../lib/schema';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const featured = articles.slice(0, 6);
const popularSlugs = [
  'zayavlenie-o-prestuplenii',
  'zhaloba-125-upk',
  'apellyatsionnaya-zhaloba-na-prigovor',
  'isk-o-vozmeshchenii-vreda-dtp',
  'isk-o-vzyskanii-alimentov',
  'zayavlenie-ob-obespechenii-iska',
];
const popular = popularSlugs
  .map((slug) => documents.find((document) => document.slug === slug))
  .filter((document) => document !== undefined);

const title = 'Материалы — разборы и образцы документов · адвокат Юрий Кочевинов';
const description =
  'Один раздел: практические разборы ситуаций и образцы заявлений, жалоб, ходатайств и исков. Правовая основа, адресат, сроки, текст на сайте и PDF.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Материалы адвоката Юрия Кочевинова',
  description,
  url: canonicalUrl(site.url, '/materialy/'),
  isPartOf: { '@type': 'WebSite', name: `Адвокат ${site.name}`, url: canonicalUrl(site.url, '/') },
  hasPart: [
    {
      '@type': 'CollectionPage',
      name: 'Разборы',
      url: canonicalUrl(site.url, '/materialy/razbory/'),
      numberOfItems: articles.length,
    },
    {
      '@type': 'CollectionPage',
      name: 'Образцы документов',
      url: canonicalUrl(site.url, '/materialy/obrazcy/'),
      numberOfItems: documents.length,
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={[schema, breadcrumbs([{ name: 'Главная', path: '/' }, { name: 'Материалы', path: '/materialy/' }])]}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href={withBase('/')}>Главная</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Материалы</span>
      </nav>
      <p class="eyebrow eyebrow--meta">
        <span>Материалы</span>
        <span>{articles.length} {plural(articles.length, 'разбор', 'разбора', 'разборов')}</span>
        <span>{documents.length} {plural(documents.length, 'образец', 'образца', 'образцов')}</span>
      </p>
      <h1 class="page-hero__title">Сначала разобраться,<br /><em>потом действовать</em></h1>
      <p class="page-hero__lead">
        Здесь два вида материалов, и они дополняют друг друга: разборы объясняют, что происходит в
        конкретной ситуации, а образцы документов помогают оформить свою позицию. И то и другое —
        ориентиры, а не замена консультации.
      </p>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="materialy-parts">
    <div class="container">
      <div class="compact-head">
        <div>
          <p class="eyebrow">Два раздела</p>
          <h2 id="materialy-parts">Что можно найти</h2>
        </div>
        <p class="compact-head__note">
          Материалы обновляются. Нормы и сроки проверены на дату публикации, но применимость
          зависит от обстоятельств дела.
        </p>
      </div>

      <div class="materials-hub">
        <a class="hub-card" href={withBase('/materialy/razbory/')} data-reveal>
          <span class="hub-card__count">{articles.length}</span>
          <h3>Разборы</h3>
          <p>
            Обыск, допрос, задержание, мера пресечения, апелляция, ДТП, алименты, приставы,
            трудовые споры. Что происходит, какие нормы действуют и какие шаги имеют смысл.
          </p>
          <span class="hub-card__link">
            Читать разборы
            <Icon name="arrow-right" size={15} />
          </span>
        </a>
        <a class="hub-card" href={withBase('/materialy/obrazcy/')} data-reveal>
          <span class="hub-card__count">{documents.length}</span>
          <h3>Образцы документов</h3>
          <p>
            Заявления, жалобы, ходатайства и иски. Для каждого — правовая основа, адресат, срок
            подачи, полный текст на сайте и файл PDF для скачивания.
          </p>
          <span class="hub-card__link">
            Открыть образцы
            <Icon name="arrow-right" size={15} />
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--milk" aria-labelledby="latest-title">
    <div class="container">
      <div class="compact-head">
        <div>
          <p class="eyebrow">Разборы</p>
          <h2 id="latest-title">С чего начать</h2>
        </div>
        <a class="link-arrow" href={withBase('/materialy/razbory/')}>
          Все разборы
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
      <div class="articles-list">
        {
          featured.map((item) => (
            <a class="article-row" href={withBase(`/materialy/razbory/${item.id}/`)} data-reveal>
              <div class="article-row__meta">
                <span>{item.data.category}</span>
                <span>{formatDate(item.data.publishedAt)}</span>
                <span>{item.data.readingTime}</span>
              </div>
              <div>
                <h3 class="article-row__title">{item.data.title}</h3>
                <p class="article-row__desc">{item.data.description}</p>
              </div>
              <Icon name="arrow-up-right" size={18} class="article-row__arrow" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="popular-docs">
    <div class="container">
      <div class="compact-head">
        <div>
          <p class="eyebrow">Образцы</p>
          <h2 id="popular-docs">Чаще всего нужны</h2>
        </div>
        <a class="link-arrow" href={withBase('/materialy/obrazcy/')}>
          Все образцы
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
      <div class="cases-grid doc-grid">
        {
          popular.map((document) => (
            <article class="case-card doc-card" data-reveal>
              <p class="case-card__meta">
                <span>{document.group}</span>
                <span>{document.basis}</span>
              </p>
              <h3 class="case-card__title">
                <a class="doc-card__link" href={withBase(`/materialy/obrazcy/${document.slug}/`)}>
                  {document.short}
                </a>
              </h3>
              <p class="case-card__summary">{document.summary}</p>
              <div class="doc-card__actions">
                <a
                  class="btn btn--outline btn--small"
                  href={withBase(`/documents/${document.slug}.pdf`)}
                  download
                  data-goal="document_download"
                >
                  Скачать PDF
                </a>
                <a class="doc-card__text" href={withBase(`/materialy/obrazcy/${document.slug}/`)}>
                  Текст
                  <Icon name="arrow-right" size={14} />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="doc-groups-note">
        <p class="eyebrow">Состав раздела</p>
        <ul class="doc-groups-note__list">
          {
            documentGroupsWithCount.map((entry) => (
              <li>
                <span>{entry.group}</span>
                <strong>{entry.items.length}</strong>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="practice-policy" data-reveal>
        <h2>Как пользоваться материалами</h2>
        <div class="practice-policy__grid">
          <div>
            <h3>Разбор — не консультация</h3>
            <p>
              Текст описывает общую логику норм и практики. Значение имеют ваш статус, стадия дела
              и уже собранные материалы.
            </p>
          </div>
          <div>
            <h3>Образец — это форма</h3>
            <p>
              Перепишите обстоятельства своими словами, проверьте адресата, приложения и сроки.
              Суд оценивает содержание, а не внешний вид шаблона.
            </p>
          </div>
          <div>
            <h3>Срочное — не через сайт</h3>
            <p>
              Если проводятся следственные действия или истекает срок, напишите напрямую и
              обозначьте срочность: переписка не заменяет вызов адвоката.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactPrompt title="Не понятно, какой материал относится к вашей ситуации?" />

  <style>
    .materials-hub {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(18px, 2.6vw, 28px);
    }

    .hub-card {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: clamp(22px, 3vw, 34px);
      border: 1px solid var(--line);
      background: var(--paper, #f6f0e7);
      color: inherit;
      text-decoration: none;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .hub-card:hover,
    .hub-card:focus-visible {
      border-color: var(--gold-deep, #796039);
      transform: translateY(-2px);
    }

    .hub-card__count {
      font-family: var(--font-display, var(--font-body));
      font-size: clamp(2rem, 3.4vw, 2.8rem);
      line-height: 1;
      color: var(--gold-deep, #796039);
    }

    .hub-card h3 {
      font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    }

    .hub-card p {
      font-size: 0.94rem;
      line-height: 1.62;
      color: var(--muted);
    }

    .hub-card__link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: auto;
      padding-top: 10px;
      font-size: 0.85rem;
      letter-spacing: 0.02em;
      border-top: 1px solid var(--line);
    }

    .doc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doc-card {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .doc-card__link {
      color: inherit;
      text-decoration: none;
    }

    .doc-card__link:hover,
    .doc-card__link:focus-visible {
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .doc-card__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-top: auto;
      padding-top: 6px;
    }

    .doc-card__text {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.86rem;
      letter-spacing: 0.02em;
    }

    .btn--small {
      min-height: 40px;
      padding: 9px 16px;
      font-size: 0.78rem;
    }

    .doc-groups-note {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px 28px;
      margin-top: clamp(22px, 3vw, 30px);
      padding-top: 20px;
      border-top: 1px solid var(--line);
    }

    .doc-groups-note__list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 0.88rem;
    }

    .doc-groups-note__list li {
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      color: var(--muted);
    }

    .doc-groups-note__list strong {
      color: var(--ink, #1c1917);
      font-weight: 600;
    }

    @media (max-width: 860px) {
      .materials-hub,
      .doc-grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
</BaseLayout>
