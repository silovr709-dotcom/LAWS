---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GithubSlugger from 'github-slugger';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { formatDate, toIsoDate } from '../../../lib/format';
import { site } from '../../../data/site';
import { canonicalUrl, withBase } from '../../../lib/paths';
import { breadcrumbs } from '../../../lib/schema';
import Portrait from '../../../components/Portrait.astro';
import { services } from '../../../data/services';
import { documents } from '../../../data/documents';
import { articleDocuments, articleSituations } from '../../../data/links';
import { articlePhotos } from '../../../data/editorial';
import EditorialImage from '../../../components/EditorialImage.astro';
import { situations } from '../../../data/situations';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

interface Props {
  item: CollectionEntry<'articles'>;
}

const { item } = Astro.props;
const data = item.data;
const photo = articlePhotos[item.id];
const relatedServices = services.filter((service) => service.articleIds.includes(item.id)).slice(0, 2);
const relatedDocs = (articleDocuments[item.id] ?? [])
  .map((slug) => documents.find((document) => document.slug === slug))
  .filter((document) => document !== undefined);
const relatedSituations = (articleSituations[item.id] ?? [])
  .map((slug) => situations.find((situation) => situation.slug === slug))
  .filter((situation) => situation !== undefined);
const { Content } = await render(item);

// Содержание статьи: заголовки второго уровня, идентификаторы — как их строит Astro.
const slugger = new GithubSlugger();
const headings: { id: string; label: string }[] = [];
for (const line of (item.body ?? '').split('\n')) {
  const match = /^(#{2,3})\s+(.+)$/.exec(line.trim());
  if (!match) continue;
  const label = match[2].replace(/[*_`]/g, '').trim();
  const id = slugger.slug(label);
  if (match[1].length === 2) headings.push({ id, label });
}

const related = (
  await getCollection('articles', ({ data: other, id }) => !other.draft && id !== item.id)
)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 2);

const title = `${data.title} — адвокат Юрий Кочевинов`;
const description = data.description;
const canonical = canonicalUrl(site.url, `/materialy/razbory/${item.id}/`);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  inLanguage: 'ru-RU',
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Person',
    name: site.fullName,
    jobTitle: 'Адвокат',
    url: canonicalUrl(site.url, '/ob-advokate/'),
    image: canonicalUrl(site.url, site.portraits.avatar),
  },
  publisher: {
    '@type': 'Person',
    name: site.fullName,
  },
  about: data.category,
};
---

<BaseLayout title={title} description={description} type="article" schema={[schema, breadcrumbs([{ name: 'Главная', path: '/' }, { name: 'Материалы', path: '/materialy/' }, { name: 'Разборы', path: '/materialy/razbory/' }, { name: data.title, path: `/materialy/razbory/${item.id}/` }])]}>
  <div class="reading-progress" data-reading-progress aria-hidden="true"><span></span></div>
  <article>
    <header class="article-hero">
      <div class="container">
        <nav class="breadcrumbs breadcrumbs--light" aria-label="Хлебные крошки">
          <a href={withBase("/")}>Главная</a>
          <span aria-hidden="true">/</span>
          <a href={withBase("/materialy/")}>Материалы</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{data.category}</span>
        </nav>
        <p class="eyebrow">{data.category}</p>
        <h1 class="article-hero__title">{data.title}</h1>
        <p class="article-hero__desc">{data.description}</p>
        <div class="article-meta">
          <span>
            <time datetime={toIsoDate(data.publishedAt)}>{formatDate(data.publishedAt)}</time>
          </span>
          {
            data.updatedAt && (
              <span>
                Обновлено: <time datetime={toIsoDate(data.updatedAt)}>{formatDate(data.updatedAt)}</time>
              </span>
            )
          }
          <span>{data.readingTime}</span>
          <span>{site.fullName}</span>
        </div>
      </div>
    </header>

    {
      photo && (
        <figure class="article-cover">
          <div class="container">
            <EditorialImage
              name={photo.name}
              alt={photo.alt}
              sizes="(max-width: 900px) 92vw, 1180px"
              eager
            />
          </div>
        </figure>
      )
    }

    <div class="section section--paper">
      <div class="container article-layout">
        <div class="prose">
          <Content />

          <p class="article-disclaimer">
            Материал носит информационный характер и не является юридической консультацией.
            Применимость приведённых норм и выводов зависит от обстоятельств конкретного дела.
            Для оценки своей ситуации обратитесь к адвокату.
          </p>
        </div>

        <aside class="article-aside">
          {
            headings.length > 1 && (
              <nav class="aside-card article-toc" aria-labelledby="article-toc-title" data-article-toc>
                <h2 id="article-toc-title">Содержание</h2>
                <ol>
                  {headings.map((heading) => (
                    <li><a href={`#${heading.id}`} data-toc-link>{heading.label}</a></li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div class="aside-card">
            <h2>Источники</h2>
            {
              data.sources.length > 0 ? (
                <ul class="sources-list">
                  {data.sources.map((source) => (
                    <li>
                      <a href={source.url} target="_blank" rel="noopener noreferrer">
                        {source.label}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>Ссылки на нормативные акты приведены в тексте.</p>
              )
            }
          </div>

          <div class="author-card">
            <Portrait variant="avatar" />
            <span class="author-card__role">Автор</span>
            <span class="author-card__name">{site.fullName}</span>
            <p>
              Адвокат, реестровый номер {site.registryNumber}, {site.chamber}.
              Уголовно-правовая защита. Тверь и вся Россия.
            </p>
            <a class="link-arrow" href={withBase("/ob-advokate/")}>
              Об адвокате
              <Icon name="arrow-right" size={14} />
            </a>
          </div>

          {relatedServices.length > 0 && <div class="aside-card"><h2>Направления помощи</h2><ul class="sources-list">{relatedServices.map((service) => <li><a href={withBase(`/napravleniya/${service.slug}/`)}>{service.title}</a></li>)}</ul></div>}

          <div class="aside-card">
            <h2>Обсудить ситуацию</h2>
            <p>
              Если вопрос касается вас или близкого человека, разумнее обсудить обстоятельства
              напрямую.
            </p>
            <p style="margin-top: 12px;">
              <a class="btn btn--primary" href={withBase("/#kontakty")}>Связаться с адвокатом</a>
            </p>
          </div>
        </aside>
      </div>
    </div>

    {(relatedDocs.length > 0 || relatedSituations.length > 0) && (
      <section class="section section--paper" aria-labelledby="article-tools">
        <div class="container">
          <h2 id="article-tools" style="margin-bottom: 24px;">Применить на практике</h2>
          {relatedSituations.length > 0 && (
            <p style="margin-bottom: 18px;">
              {relatedSituations.map((situation) => (
                <a class="link-arrow" href={withBase(`/situacii/${situation.slug}/`)} style="margin-right: 18px;">
                  Навигатор: {situation.title} <Icon name="arrow-right" size={15} />
                </a>
              ))}
            </p>
          )}
          <div class="link-grid">
            {relatedDocs.map((document) => (
              <a href={withBase(`/materialy/obrazcy/${document.slug}/`)} data-goal="doc_open">
                {document.short}
                <span>{document.group} · {document.deadline || document.addressee}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {
      related.length > 0 && (
        <section class="section section--milk" aria-labelledby="related-title">
          <div class="container">
            <h2 id="related-title" style="margin-bottom: 24px;">
              Другие разборы
            </h2>
            <div class="articles-list">
              {related.map((other) => (
                <a class="article-row" href={withBase(`/materialy/razbory/${other.id}/`)}>
                  <div class="article-row__meta">
                    <span>{other.data.category}</span>
                    <span>{formatDate(other.data.publishedAt)}</span>
                  </div>
                  <div>
                    <h3 class="article-row__title">{other.data.title}</h3>
                    <p class="article-row__desc">{other.data.description}</p>
                  </div>
                  <Icon name="arrow-up-right" size={18} class="article-row__arrow" />
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <script>
    const bar = document.querySelector('[data-reading-progress] span') as HTMLElement | null;
    const article = document.querySelector('article');
    if (bar && article) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight + 160;
        const passed = Math.min(Math.max(-rect.top + 80, 0), Math.max(total, 1));
        bar.style.transform = `scaleX(${passed / Math.max(total, 1)})`;
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    }

    // Подсветка текущего раздела в содержании.
    const toc = document.querySelector<HTMLElement>('[data-article-toc]');
    if (toc && 'IntersectionObserver' in window) {
      const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
      const sections = links
        .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
        .filter((section): section is HTMLElement => Boolean(section));
      const setCurrent = (id: string) => {
        for (const link of links) {
          const active = decodeURIComponent(link.hash.slice(1)) === id;
          link.toggleAttribute('aria-current', active);
          if (active) link.setAttribute('aria-current', 'true');
        }
      };
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible) setCurrent(visible.target.id);
        },
        { rootMargin: '-96px 0px -64% 0px', threshold: 0 },
      );
      sections.forEach((section) => observer.observe(section));
    }
  </script>
</BaseLayout>
