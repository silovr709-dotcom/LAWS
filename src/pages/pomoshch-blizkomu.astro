---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPrompt from '../components/ContactPrompt.astro';
import HeroBrief from '../components/HeroBrief.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { canonicalUrl, withBase } from '../lib/paths';
import { breadcrumbs } from '../lib/schema';

const title = 'Если помощь нужна близкому человеку — адвокат Юрий Кочевинов';
const description =
  'Что уточнить перед обращением к адвокату, если близкого человека задержали, вызвали на допрос или в отношении него проводится проверка. Общие ориентиры без передачи чувствительных сведений.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Если помощь нужна близкому человеку',
    description,
    url: canonicalUrl(site.url, '/pomoshch-blizkomu/'),
    inLanguage: 'ru-RU',
    isPartOf: { '@type': 'WebSite', name: `Адвокат ${site.name}`, url: canonicalUrl(site.url, '/') },
  },
  breadcrumbs([
    { name: 'Главная', path: '/' },
    { name: 'Срочно', path: '/srochno/' },
    { name: 'Помощь близкому', path: '/pomoshch-blizkomu/' },
  ]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <header class="detail-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href={withBase('/')}>Главная</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/srochno/')}>Срочно</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Помощь близкому</span>
      </nav>
      <div class="detail-hero__grid detail-hero__grid--brief">
        <div>
          <p class="eyebrow">Ориентиры для первого обращения</p>
          <h1>Если помощь нужна<br /><em>близкому человеку</em></h1>
          <p class="detail-hero__lead">
            В тревожной ситуации не нужно разбираться во всём самостоятельно. Для начала важно
            собрать несколько проверяемых фактов, зафиксировать время и обозначить срочность.
          </p>
        </div>
        <HeroBrief
          title="В первые минуты"
          items={[
            { label: 'Главное уточнить', value: 'Город, подразделение и точное время задержания' },
            { label: 'Срок задержания', value: 'До 48 часов с момента фактического ограничения свободы' },
          ]}
          note="Соглашение об оказании помощи адвокат вправе заключить с родственником в интересах другого лица."
        />
      </div>
    </div>
  </header>

  <section class="section section--paper">
    <div class="container service-detail">
      <div class="prose">
        <h2 id="chto-vyyasnit">Что постараться выяснить</h2>
        <ol>
          <li><strong>Где находится человек.</strong> Город, подразделение, изолятор или суд, если это известно.</li>
          <li><strong>Каков его статус.</strong> Приглашён для объяснений, вызван на допрос, задержан или участвует в уже рассматриваемом деле. Если статус неизвестен, так и сообщите.</li>
          <li><strong>Что произошло и во сколько.</strong> Запишите точное время фактического задержания — от него считаются процессуальные 48 часов, а не от момента звонка.</li>
          <li><strong>Есть ли ближайшие сроки.</strong> Когда назначен допрос, судебное заседание по мере пресечения или вручение постановления.</li>
        </ol>

        <h2 id="chto-napisat">Что написать адвокату</h2>
        <p>
          В первом сообщении достаточно обозначить, что помощь нужна близкому, указать город,
          известный статус и время ближайшего действия. Фамилии, копии документов и подробности дела
          передавайте только после согласования безопасного канала.
        </p>

        <h2 id="chego-izbegat">С чем лучше не торопиться</h2>
        <ul>
          <li>Не публикуйте в социальных сетях и чатах документы, сведения об участниках и собственные версии событий.</li>
          <li>Не обсуждайте обстоятельства дела по открытой телефонной связи и не пытайтесь согласовывать показания.</li>
          <li>Не считайте обещание «просто поговорить» заменой выяснению процессуального статуса и участия защитника.</li>
        </ul>

        <h2 id="srochnost">Если ситуация неотложная</h2>
        <p>
          Личные сообщения и обращения через сайт не гарантируют немедленного ответа. Уточните
          возможность участия адвоката прямо при обращении. Если требуется срочная защита, не
          полагайтесь только на переписку; самому задержанному следует прямо заявить о необходимости
          участия защитника с фиксацией в протоколе.
        </p>

        <p class="article-disclaimer">
          Это общие ориентиры, а не индивидуальная юридическая консультация. Объём прав, порядок
          участия адвоката и необходимые действия зависят от статуса и конкретных обстоятельств.
        </p>
      </div>

      <aside class="service-detail__aside">
        <nav aria-label="На этой странице">
          <p class="eyebrow">На этой странице</p>
          <a href="#chto-vyyasnit">Что выяснить</a>
          <a href="#chto-napisat">Что написать адвокату</a>
          <a href="#chego-izbegat">С чем не торопиться</a>
          <a href="#srochnost">Если ситуация неотложная</a>
        </nav>
        <div class="service-detail__aside-note">
          <p class="eyebrow">Срочные инструменты</p>
          <h2>Счётчик 48 часов</h2>
          <p>Введите время задержания и отправьте ссылку с отсчётом другим членам семьи.</p>
          <a class="link-arrow" href={withBase('/48-chasov/')}>Открыть счётчик<Icon name="arrow-right" size={14} /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--milk" aria-labelledby="blizkomu-tools">
    <div class="container">
      <div class="compact-head">
        <div>
          <p class="eyebrow">Инструменты для близких</p>
          <h2 id="blizkomu-tools">Что открыть дальше</h2>
        </div>
      </div>
      <div class="link-grid">
        <a href={withBase('/48-chasov/')}>
          Счётчик 48 часов
          <span>Пять контрольных сроков после задержания и ссылка для семьи</span>
        </a>
        <a href={withBase('/bezopasnaya-peredacha-dokumentov/#pervoe-soobshchenie')}>
          Собрать первое сообщение адвокату
          <span>Конструктор короткого обращения без лишних персональных данных</span>
        </a>
        <a href={withBase('/srochno/')}>
          Задержали: что делать в первые часы
          <span>Короткие формулировки и список документов, которые нельзя подписывать не глядя</span>
        </a>
        <a href={withBase('/memos/pervye-48-chasov/')}>
          Памятка на одну страницу PDF
          <span>Сохранить в телефон или распечатать перед поездкой в отдел</span>
        </a>
      </div>
    </div>
  </section>

  <ContactPrompt title="Обозначьте, кому нужна помощь, город и какие сроки известны" />
</BaseLayout>
