---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovedPage from '../../components/MovedPage.astro';
import { withBase } from '../../lib/paths';

const target = withBase('/materialy/razbory/');
---

<BaseLayout
  title="Материалы переехали — адвокат Юрий Кочевинов"
  description="Разборы и образцы документов теперь находятся в одном разделе «Материалы» на сайте адвоката Юрия Кочевинова."
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0; url=${target}`} />
  <MovedPage
    to="/materialy/razbory/"
    heading="Разборы переехали"
    note="Тексты и образцы документов теперь в одном разделе «Материалы»."
  />
  <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
</BaseLayout>
