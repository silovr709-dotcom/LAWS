---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactPrompt from '../components/ContactPrompt.astro';
import { canonicalUrl, withBase } from '../lib/paths';
import { site } from '../data/site';

const title = 'Как мы работаем и из чего складывается стоимость';
const description =
  'Порядок работы адвоката: первый контакт, соглашение, изучение материалов, план защиты, участие в следственных действиях и суде. Что влияет на стоимость и как фиксируются условия — без прайса и обещаний результата.';

const stages = [
  {
    title: 'Первый контакт',
    text: 'Коротко: что произошло, процессуальный статус, ближайшие сроки и город. Без документов и подробностей в первом сообщении — канал передачи материалов согласуем отдельно.',
  },
  {
    title: 'Соглашение',
    text: 'Если поручение принимается, объём помощи, стоимость, порядок оплаты и формат взаимодействия фиксируются письменно. Только после этого начинается работа по существу.',
  },
  {
    title: 'Изучение материалов',
    text: 'Постановления, протоколы, повестки, переписка, документы по делу. На этом этапе формируется фактическая картина и перечень вопросов, требующих проверки.',
  },
  {
    title: 'План и позиция',
    text: 'Что оспариваем, чем подтверждаем, какие ходатайства и в какой последовательности подаём. План обсуждается с доверителем до процессуальных действий.',
  },
  {
    title: 'Участие',
    text: 'Следственные действия, судебные заседания, работа с экспертизами, жалобы и ходатайства. Объём участия определяется соглашением, а не ожиданиями «в целом».',
  },
  {
    title: 'Обратная связь',
    text: 'О результате каждого действия и о следующем шаге доверитель узнаёт по согласованному каналу. Сроки и ограничения обсуждаются сразу, а не после.',
  },
];

const costFactors = [
  { title: 'Стадия', text: 'Проверка, следствие, первая инстанция, апелляция и кассация — разный объём работы и разные сроки.' },
  { title: 'Срочность', text: 'Задержание и мера пресечения требуют немедленного включения, в том числе в выходные.' },
  { title: 'Объём материалов', text: 'Количество томов, эпизодов, экспертиз и участников напрямую влияет на время изучения.' },
  { title: 'География', text: 'Тверь, Москва, Мурманская область и другие регионы: выезд и дистанционное участие считаются по-разному.' },
  { title: 'Формат участия', text: 'Разовые действия, участие в конкретном заседании или сопровождение дела на всей стадии.' },
  { title: 'Состав помощи', text: 'Только защита, защита вместе с представительством по гражданскому иску или отдельное обжалование.' },
];

const faq = [
  {
    q: 'Можно ли узнать стоимость заранее?',
    a: 'Точная стоимость определяется после первого разговора: она зависит от стадии, срочности, объёма материалов и формата участия. Условия фиксируются в соглашении до начала работы; скрытых доплат по ходу дела быть не должно.',
  },
  {
    q: 'Оплата зависит от результата?',
    a: 'Нет. Стоимость определяется объёмом помощи, а не исходом дела. Адвокат не вправе обещать результат, а доверитель не должен рассчитывать на возврат оплаты при неблагоприятном решении.',
  },
  {
    q: 'Можно ли работать дистанционно?',
    a: 'Да, если это допускает процессуальная ситуация: консультации, подготовка документов и часть участия возможны удалённо. Выезд и личное участие обсуждаются отдельно и влияют на стоимость.',
  },
  {
    q: 'Что будет с моими документами?',
    a: 'Материалы передаются по согласованному каналу и используются только в рамках поручения. Как подготовиться к безопасной передаче — на отдельной странице.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonicalUrl(site.url, '/kak-my-rabotaem/'),
    inLanguage: 'ru-RU',
    isPartOf: { '@type': 'WebSite', name: `Адвокат ${site.name}`, url: canonicalUrl(site.url, '/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: canonicalUrl(site.url, '/') },
      { '@type': 'ListItem', position: 2, name: 'Как мы работаем', item: canonicalUrl(site.url, '/kak-my-rabotaem/') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout title={`${title} — адвокат Юрий Кочевинов`} description={description} schema={schema}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href={withBase('/')}>Главная</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Как мы работаем</span>
      </nav>
      <p class="eyebrow">Порядок работы · без прайса</p>
      <h1 class="page-hero__title">Понятные этапы,<br /><em>а не «разберёмся по ходу»</em></h1>
      <p class="page-hero__lead">
        Ниже — как устроена работа и от чего зависит стоимость. Цифры не публикуются, потому что
        зависят от конкретной ситуации; но порядок, границы помощи и способ оплаты фиксируются
        письменно до начала работы.
      </p>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="etapy">
    <div class="container">
      <div class="compact-head">
        <div>
          <p class="eyebrow">Этапы</p>
          <h2 id="etapy">От первого сообщения до результата</h2>
        </div>
        <p>Каждый этап заканчивается понятным итогом: документом, решением или следующим шагом.</p>
      </div>
      <ol class="action-steps" style="max-width: 820px;">
        {stages.map((stage) => (
          <li>
            <strong>{stage.title}</strong>
            {stage.text}
          </li>
        ))}
      </ol>
      <p class="detail-note" style="margin-top: 24px;">
        Обращение само по себе не создаёт отношений «адвокат — доверитель» и не обязывает заключать
        соглашение. Работа начинается после подписания соглашения и согласования условий.
      </p>
    </div>
  </section>

  <section class="section section--milk" aria-labelledby="stoimost">
    <div class="container">
      <div class="compact-head">
        <div>
          <p class="eyebrow">Стоимость</p>
          <h2 id="stoimost">Из чего она складывается</h2>
        </div>
        <p>Не «тариф за дело», а объём конкретной помощи. Эти факторы обсуждаются на первом разговоре.</p>
      </div>
      <div class="link-grid">
        {costFactors.map((factor) => (
          <div style="background: var(--paper); padding: 20px 22px;">
            <strong style="display: block; font-family: var(--font-display); font-size: 1.2rem; color: var(--wine); margin-bottom: 6px;">{factor.title}</strong>
            <span style="font-size: 0.875rem; color: var(--muted);">{factor.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="chego-net">
    <div class="container">
      <div class="compact-head">
        <div>
          <p class="eyebrow">Границы</p>
          <h2 id="chego-net">Чего здесь не будет</h2>
        </div>
      </div>
      <div class="calc-grid">
        <article class="calc">
          <h3>Обещаний результата</h3>
          <ul class="rule-list rule-list--no">
            <li>«Гарантируем оправдательный приговор» — так не работает ни у одного адвоката.</li>
            <li>«Решим вопрос по знакомству» — вне процесса такие договорённости не обсуждаются.</li>
            <li>«Заплатите — и дело закроют» — оплата не покупает процессуальное решение.</li>
          </ul>
        </article>
        <article class="calc">
          <h3>Что будет вместо</h3>
          <ul class="rule-list">
            <li>Оценка рисков и честный разговор о том, что зависит от адвоката, а что нет.</li>
            <li>План действий с документами и сроками.</li>
            <li>Письменное соглашение: объём помощи, стоимость, порядок оплаты.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--milk" aria-labelledby="faq-rabota">
    <div class="container">
      <div class="compact-head">
        <div>
          <p class="eyebrow">Частые вопросы</p>
          <h2 id="faq-rabota">О работе и оплате</h2>
        </div>
      </div>
      <div class="faq">
        {faq.map((item) => (
          <details class="accordion__item">
            <summary class="accordion__summary">{item.q}</summary>
            <div class="accordion__content"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
      <p class="detention__advice-links" style="margin-top: 22px;">
        <a class="link-arrow" href={withBase('/bezopasnaya-peredacha-dokumentov/')}>
          Как безопасно передать документы <Icon name="arrow-right" size={15} />
        </a>
        <a class="link-arrow" href={withBase('/kak-proverit-advokata/')}>
          Как проверить статус адвоката <Icon name="arrow-right" size={15} />
        </a>
        <a class="link-arrow" href={withBase('/ob-advokate/')}>
          Об адвокате и опыте <Icon name="arrow-right" size={15} />
        </a>
      </p>
    </div>
  </section>

  <ContactPrompt title="Обсудим стадию дела, сроки и формат помощи" />
</BaseLayout>
