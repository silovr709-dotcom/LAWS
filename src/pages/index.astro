---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Directions from '../components/Directions.astro';
import Approach from '../components/Approach.astro';
import About from '../components/About.astro';
import PracticePreview from '../components/PracticePreview.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { faq, hero, site } from '../data/site';

const title = `Адвокат Юрий Кочевинов — уголовно-правовая защита в Мурманске`;
const description =
  'Адвокат Юрий Анатольевич Кочевинов, Мурманск. Уголовно-правовая защита: доследственная проверка, экономические и должностные преступления, представительство потерпевших, апелляция и кассация.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.fullName,
    givenName: 'Юрий',
    familyName: 'Кочевинов',
    jobTitle: 'Адвокат',
    description: 'Адвокат, партнёр адвокатского бюро «Панфилов и партнёры», Мурманск.',
    url: site.url,
    image: `${site.url}/og/og-default.png`,
    worksFor: {
      '@type': 'Organization',
      name: site.bureau,
      url: site.bureauUrl,
    },
    memberOf: {
      '@type': 'Organization',
      name: site.chamber,
      url: site.chamberUrl,
    },
    identifier: {
      '@type': 'PropertyValue',
      propertyID: 'Реестровый номер адвоката',
      value: site.registryNumber,
    },
    award: [
      'Нагрудный знак «За верность закону»',
      'Медаль «Ягужинского»',
    ],
    sameAs: [site.vk],
    knowsLanguage: ['ru'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LegalService',
    name: 'Адвокат Юрий Кочевинов',
    description:
      'Уголовно-правовая защита, представительство потерпевших, обжалование приговоров. Мурманск и Мурманская область.',
    url: site.url,
    image: `${site.url}/og/og-default.png`,
    telephone: site.phone.display,
    email: site.email,
    areaServed: [
      { '@type': 'City', name: 'Мурманск' },
      { '@type': 'AdministrativeArea', name: 'Мурманская область' },
    ],
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.office.street,
      addressLocality: site.office.city,
      postalCode: site.office.postalCode,
      addressCountry: 'RU',
    },
    founder: {
      '@type': 'Person',
      name: site.fullName,
    },
    sameAs: [site.vk],
    knowsAbout: [
      'Уголовное право',
      'Уголовный процесс',
      'Доследственная проверка',
      'Экономические преступления',
      'Должностные преступления',
      'Апелляция и кассация',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `Адвокат ${site.name}`,
    url: site.url,
    inLanguage: 'ru-RU',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="website"
  overHero
  schema={schemas}
>
  <Hero />
  <Directions />
  <Approach />
  <About />
  <PracticePreview />
  <Process />
  <Faq />
  <Contact />
</BaseLayout>
