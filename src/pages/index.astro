---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Directions from '../components/Directions.astro';
import Approach from '../components/Approach.astro';
import About from '../components/About.astro';
import PracticePreview from '../components/PracticePreview.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Urgent from '../components/Urgent.astro';
import Contact from '../components/Contact.astro';
import { faq, site } from '../data/site';
import { canonicalUrl } from '../lib/paths';
import PublicationsPreview from '../components/PublicationsPreview.astro';

const title = 'Адвокат Юрий Кочевинов — уголовно-правовая защита в Твери и по всей России';
const description =
  'Адвокат Юрий Анатольевич Кочевинов: уголовно-правовая защита на любой стадии — доследственная проверка, экономические и должностные преступления, представительство потерпевших, апелляция и кассация. Приём в Твери, работа по всей России.';

const personSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': canonicalUrl(site.url, '/ob-advokate/#person'),
  name: site.fullName,
  givenName: 'Юрий',
  familyName: 'Кочевинов',
  jobTitle: 'Адвокат',
  description:
    'Адвокат, специализация — уголовно-правовая защита. Приём в Твери, работа по всей России.',
  url: canonicalUrl(site.url, '/'),
  image: canonicalUrl(site.url, site.portrait),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'RU',
  },
  memberOf: {
    '@type': 'Organization',
    name: site.chamber,
    url: site.chamberUrl,
  },
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Реестровый номер адвоката',
    value: site.registryNumber,
  },
  award: ['Нагрудный знак «За верность закону»', 'Медаль «Ягужинского»'],
  sameAs: [site.vk],
  knowsLanguage: ['ru'],
};

const serviceSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'Адвокат Юрий Кочевинов',
  description:
    'Уголовно-правовая защита, представительство потерпевших, обжалование приговоров. Приём в Твери, работа по всей России.',
  url: canonicalUrl(site.url, '/'),
  image: canonicalUrl(site.url, site.portrait),
  areaServed: [
    { '@type': 'Country', name: 'Россия' },
    { '@type': 'City', name: 'Тверь' },
  ],
  founder: { '@type': 'Person', name: site.fullName },
  sameAs: [site.vk],
  knowsAbout: [
    'Уголовное право',
    'Уголовный процесс',
    'Доследственная проверка',
    'Экономические преступления',
    'Должностные преступления',
    'Апелляция и кассация',
  ],
};

const schemas = [
  personSchema,
  serviceSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `Адвокат ${site.name}`,
    url: canonicalUrl(site.url, '/'),
    inLanguage: 'ru-RU',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="website"
  overHero
  schema={schemas}
>
  <Hero />
  <Urgent />
  <Directions />
  <About />
  <Approach />
  <PracticePreview />
  <Process />
  <PublicationsPreview />
  <Faq />
  <Contact />
</BaseLayout>
