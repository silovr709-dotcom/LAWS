---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { memos, type Memo } from '../../data/memos';
import { canonicalUrl, withBase } from '../../lib/paths';
import { site } from '../../data/site';

export function getStaticPaths() {
  return memos.map((memo) => ({ params: { slug: memo.slug }, props: { memo } }));
}

interface Props {
  memo: Memo;
}

const { memo } = Astro.props;
const url = canonicalUrl(site.url, `/memos/${memo.slug}/`);
const pdf = canonicalUrl(site.url, `/memos/${memo.slug}.pdf`);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'DigitalDocument',
    name: memo.title,
    description: memo.intro,
    url: pdf,
    encodingFormat: 'application/pdf',
    inLanguage: 'ru-RU',
    author: { '@type': 'Person', name: site.fullName, url: canonicalUrl(site.url, '/ob-advokate/') },
    isPartOf: { '@type': 'WebSite', name: `Адвокат ${site.name}`, url: canonicalUrl(site.url, '/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: canonicalUrl(site.url, '/') },
      { '@type': 'ListItem', position: 2, name: 'Памятки', item: canonicalUrl(site.url, '/memos/') },
      { '@type': 'ListItem', position: 3, name: memo.title, item: url },
    ],
  },
];
---

<BaseLayout title={`${memo.title} — памятка адвоката Юрия Кочевинова`} description={memo.intro} schema={schema}>
  <section class="section section--milk">
    <div class="container">
      <nav class="breadcrumbs memo-noprint" aria-label="Хлебные крошки">
        <a href={withBase('/')}>Главная</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/memos/')}>Памятки</a>
      </nav>

      <div class="memo-noprint" style="display: flex; flex-wrap: wrap; gap: 12px; margin: 18px 0 22px;">
        <a class="btn btn--outline" href={withBase(`/memos/${memo.slug}.pdf`)} download data-goal="memo_download">
          Скачать PDF <Icon name="arrow-right" size={15} />
        </a>
        <button class="btn btn--outline" type="button" data-print>Распечатать</button>
        <a class="btn btn--outline" href={withBase('/memos/')}>Все памятки</a>
      </div>

      <article class="memo-sheet">
        <p class="memo-sheet__subtitle">{memo.subtitle}</p>
        <h1>{memo.title}</h1>
        <p class="memo-sheet__intro">{memo.intro}</p>
        {memo.sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            <ul>
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))}
        <p class="memo-sheet__footer">{memo.footer}</p>
      </article>

      <div class="memo-noprint" style="max-width: 760px; margin: 24px auto 0;">
        <p class="detail-note">
          Дальше по теме: <a href={withBase('/srochno/')}>что делать в первые часы</a>,
          {' '}<a href={withBase('/situacii/')}>навигатор по ситуациям</a>,
          {' '}<a href={withBase('/sroki/')}>калькулятор сроков</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
