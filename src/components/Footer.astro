---
import { navigation, site, footer } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="brand" href="/" aria-label={`${site.name} — на главную`}>
          <span class="brand__mark" aria-hidden="true">ЮК</span>
          <span class="brand__text">
            <span class="brand__name">{site.name}</span>
            <span class="brand__role">{site.role} · {site.city}</span>
          </span>
        </a>
        <p>
          Уголовно-правовая защита, представительство потерпевших, работа на стадии проверки,
          апелляции и кассации.
        </p>
      </div>

      <div class="footer__col">
        <h2>Разделы</h2>
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h2>Контакты</h2>
        <ul>
          <li><a href={`tel:${site.phone.href}`}>{site.phone.display}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a href={site.vk} target="_blank" rel="noopener noreferrer">ВКонтакте</a>
          </li>
          <li><a href={site.mapUrl} target="_blank" rel="noopener noreferrer">{site.office.city}, {site.office.street}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2>Документы</h2>
        <ul>
          <li><a href="/politika-personalnyh-dannyh/">Политика обработки данных</a></li>
          <li><a href="/soglasie-na-obrabotku-personalnyh-dannyh/">Согласие на обработку</a></li>
          <li><a href="/pravovaya-informaciya/">Правовая информация</a></li>
          <li><a href="/publikacii/">Публикации</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__ethics">
        {footer.ethics}
        <br />
        {footer.rights}
      </p>
      <div class="footer__legal">
        <span>© {new Date().getFullYear()} {site.fullName}</span>
        <span>Реестровый номер {site.registryNumber}</span>
      </div>
    </div>
  </div>
</footer>
