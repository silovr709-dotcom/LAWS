---
interface Props {
  name: 'arrow-right' | 'arrow-down' | 'arrow-up-right' | 'phone' | 'mail' | 'pin' | 'vk' | 'check' | 'doc';
  size?: number;
  stroke?: number;
  class?: string;
}

const { name, size = 16, stroke = 1.4, class: className } = Astro.props;
const paths: Record<string, string> = {
  'arrow-down': '<path d="M8 2v11M4 9l4 4 4-4"/>',
  'arrow-right': '<path d="M2 8h11M9 4l4 4-4 4"/>',
  'arrow-up-right': '<path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"/>',
  phone:
    '<path d="M4.2 2.6 6 2.2c.3 0 .5.1.6.4l.8 2.4c.1.2 0 .5-.2.7l-1 .8c.6 1.4 1.7 2.5 3.1 3.1l.8-1c.2-.2.4-.3.7-.2l2.4.8c.3.1.4.3.4.6l-.4 1.8c-.1.3-.3.4-.6.4C8 12.8 3.2 8 2.8 3.2c0-.3.1-.5.4-.6Z"/>',
  mail: '<path d="M1.5 3.5h13v9h-13z"/><path d="m1.8 4 5.7 4.4L13.8 4"/>',
  pin: '<path d="M8 14s4.5-4.3 4.5-7.4A4.5 4.5 0 0 0 3.5 6.6C3.5 9.7 8 14 8 14Z"/><circle cx="8" cy="6.6" r="1.6"/>',
  vk: '<path d="M2 5h2c.3 3 1.7 4.8 2.9 5.3V5h1.9v3.1c1-.1 2-1.2 2.4-3.1h1.9c-.3 1.8-1.4 3.3-2.4 3.9 1 .5 2.2 1.8 2.7 3.6h-2.1c-.4-1.2-1.2-2.2-2.5-2.3V12H7.6C4.5 12 2.4 9.4 2 5Z"/>',
  check: '<path d="m3 8.5 3 3 7-7"/>',
  doc: '<path d="M4 1.5h5l3 3v10H4z"/><path d="M9 1.7V5h3M6 8h4M6 10.5h4"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
