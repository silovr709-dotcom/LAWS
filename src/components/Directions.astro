---
import { directions } from '../data/site';
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';
const summaries = [
  'Вызвали для объяснений, проводят проверку или оперативные мероприятия.',
  'Уголовные риски бизнеса, налоговые претензии и вопросы о причинённом ущербе.',
  'Обвинения, связанные с полномочиями, управленческими решениями и подкупом.',
  'Помощь врачам и клиникам в делах о качестве и безопасности медицинской помощи.',
  'От заявления о преступлении до суда и вопросов о возмещении вреда.',
  'Анализ судебных решений и подготовка доводов для их обжалования.',
];
---
<section class="section section--paper" id="napravleniya" aria-labelledby="napravleniya-title">
  <div class="container">
    <div class="compact-head" data-reveal><div><p class="eyebrow">Направления работы</p><h2 id="napravleniya-title">Сначала — понять<br />вашу ситуацию</h2></div><p>Уголовное право и процесс.<br />От первой проверки до пересмотра приговора.</p></div>
    <div class="service-grid">
      {directions.map((direction, index) => (
        <a class="service-card" href={withBase(`/napravleniya/${direction.slug}/`)} data-reveal data-goal="service_open">
          <span class="service-card__number" aria-hidden="true">{direction.number}</span>
          <h3>{direction.title}</h3><p>{summaries[index]}</p>
          <span class="service-card__link">Подробнее<Icon name="arrow-up-right" size={16} /></span>
        </a>
      ))}
    </div>
  </div>
</section>
