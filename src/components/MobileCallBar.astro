---
import { site } from '../data/site';
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';
---

<div class="mobile-callbar" data-callbar>
  <a class="btn btn--outline" href={`tel:${site.phone.href}`}>
    <Icon name="phone" size={15} />
    Позвонить
  </a>
  <a class="btn btn--primary" href={withBase("/#kontakty")}>
    Обсудить ситуацию
    <Icon name="arrow-right" size={14} />
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-callbar]');
  const contact = document.querySelector<HTMLElement>('#kontakty');

  if (bar) {
    if (contact && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            bar.classList.toggle('is-hidden', entry.isIntersecting);
          });
        },
        { rootMargin: '0px 0px -45% 0px', threshold: 0 },
      );
      observer.observe(contact);
    }
  }
</script>
