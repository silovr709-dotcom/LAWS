---
import { hasPhone, site } from '../data/site';
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';
---

<nav class="mobile-callbar" data-callbar aria-label="Быстрая связь с адвокатом">
  {
    hasPhone ? (
      <a class="btn btn--outline" href={`tel:${site.phone.href}`} data-goal="contact_phone">
        <Icon name="phone" size={15} />
        Позвонить
      </a>
    ) : (
      <a
        class="btn btn--outline"
        href={site.vkChat} data-goal="contact_vk"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="vk" size={15} />
        Написать
      </a>
    )
  }
  <a class="btn btn--primary" href={withBase("/#kontakty")}>
    Контакты
    <Icon name="arrow-right" size={14} />
  </a>
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('[data-callbar]');
  const contact = document.querySelector<HTMLElement>('#kontakty');

  if (bar) {
    if (contact && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            bar.classList.toggle('is-hidden', entry.isIntersecting);
          });
        },
        { rootMargin: '0px 0px -45% 0px', threshold: 0 },
      );
      observer.observe(contact);
    }
  }
</script>
