---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 2);
---
{articles.length > 0 && <section class="section section--milk publication-preview" aria-labelledby="publication-preview-title"><div class="container"><div class="compact-head" data-reveal><div><p class="eyebrow">Разобраться до первого шага</p><h2 id="publication-preview-title">Полезно знать</h2></div><a class="link-arrow" href={withBase('/publikacii/')}>Все материалы<Icon name="arrow-right" size={15} /></a></div><div class="publication-preview__grid">{articles.map((item) => <a class="publication-card" href={withBase(`/publikacii/${item.id}/`)} data-reveal><span>{item.data.category} · {item.data.readingTime}</span><h3>{item.data.title}</h3><span class="publication-card__read">Читать<Icon name="arrow-up-right" size={16} /></span></a>)}</div></div></section>}
