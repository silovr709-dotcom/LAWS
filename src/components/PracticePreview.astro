---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';
const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => b.data.year - a.data.year);
---
{cases.length > 0 && <section class="section section--milk section--practice" id="praktika" aria-labelledby="praktika-title"><div class="container"><div class="compact-head"><div><p class="eyebrow">Судебная практика</p><h2 id="praktika-title">Работа в конкретных обстоятельствах</h2></div><a class="link-arrow" href={withBase('/praktika/')}>Все материалы<Icon name="arrow-right" size={15} /></a></div><div class="cases-grid">{cases.slice(0, 2).map((item) => <a class="case-card" href={withBase(`/praktika/${item.id}/`)}><p class="case-card__meta">{item.data.category} · {item.data.year}</p><h3 class="case-card__title">{item.data.title}</h3><p class="case-card__summary">{item.data.summary}</p><div class="case-card__foot"><span class="case-card__result">{item.data.result}</span><Icon name="arrow-up-right" size={15} /></div></a>)}</div><p class="detail-note">Публикуются только подтверждённые и обезличенные материалы. Результат одного дела не является обещанием аналогичного исхода по другому.</p></div></section>}
