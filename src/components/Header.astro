---
import { hasPhone, navigation, site } from '../data/site';
import Icon from './Icon.astro';
import { stripBase, withBase } from '../lib/paths';

interface Props {
  /** Прозрачная шапка поверх бордового первого экрана. */
  overHero?: boolean;
  currentPath?: string;
}

const { overHero = false, currentPath = stripBase(Astro.url.pathname) } = Astro.props;
---

<header class:list={['site-header', !overHero && 'is-solid']} data-header>
  <div class="site-header__inner">
    <a class="brand" href={withBase("/")} aria-label={`${site.name} — на главную`}>
      <span class="brand__mark" aria-hidden="true">ЮК</span>
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__role">{site.role} · {site.city}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Основная навигация">
      {navigation.map((item) => (
        <a
          class="site-nav__link"
          href={withBase(item.href)}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      {
        hasPhone ? (
          <a class="site-nav__phone" href={`tel:${site.phone.href}`}>
            {site.phone.display}
            <small>{site.phone.label}</small>
          </a>
        ) : (
          <a
            class="site-nav__phone"
            href={site.vkChat}
            target="_blank"
            rel="noopener noreferrer"
          >
            Написать
            <small>ВКонтакте · ответ в личных сообщениях</small>
          </a>
        )
      }
      <a class="header-cta" href={withBase("/#kontakty")}>
        Обсудить ситуацию
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span>Меню</span>
      <span class="menu-toggle__icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu>
  <nav class="mobile-menu__nav" aria-label="Мобильная навигация">
    {
      navigation.map((item, index) => (
        <a class="mobile-menu__link" href={withBase(item.href)} data-menu-link>
          <span>{String(index + 1).padStart(2, '0')}</span>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="mobile-menu__footer">
    {
      hasPhone ? (
        <a class="mobile-menu__phone" href={`tel:${site.phone.href}`}>{site.phone.display}</a>
      ) : (
        <a class="mobile-menu__phone" href={site.vkChat} target="_blank" rel="noopener noreferrer">
          Написать во ВКонтакте
        </a>
      )
    }
    <span>{site.hours}</span>
    <a href={site.vk} target="_blank" rel="noopener noreferrer">Страница ВКонтакте</a>
    <p class="mobile-menu__note">
      Не отправляйте в открытых каналах документы и сведения, составляющие адвокатскую тайну.
    </p>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header) {
    const overHero = header.classList.contains('site-header') && !header.classList.contains('is-solid');
    const onScroll = () => {
      const scrolled = window.scrollY > 24;
      header.classList.toggle('is-scrolled', scrolled);
      if (!overHero && !scrolled) header.classList.add('is-solid');
      if (!overHero && scrolled) header.classList.remove('is-solid');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (menu && toggle) {
    const open = () => {
      menu.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('is-locked');
      menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
    };

    const close = (restoreFocus = true) => {
      menu.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('is-locked');
      if (restoreFocus) toggle.focus({ preventScroll: true });
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) close();
      else open();
    });

    menu.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      link.addEventListener('click', () => close(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 1024 && toggle.getAttribute('aria-expanded') === 'true') {
        close(false);
      }
    });
  }
</script>
