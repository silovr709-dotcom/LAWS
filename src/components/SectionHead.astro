---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  id?: string;
  tone?: 'light' | 'dark';
  center?: boolean;
  class?: string;
}

const { eyebrow, title, lead, id, tone = 'light', center = false, class: className } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<div class:list={['section-head', center && 'section-head--center', className]} data-reveal>
  <div class="section-head__title">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={headingId}>{title}</h2>
  </div>
  {lead && <p class="section-head__lead">{lead}</p>}
</div>
