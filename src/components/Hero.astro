---
import { hero, site } from '../data/site';
import Icon from './Icon.astro';
import Portrait from './Portrait.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>
      <h1 class="hero__title" id="hero-title">
        {hero.headline.map((line) => <span>{line.emphasis ? <em>{line.text}</em> : line.text}</span>)}
      </h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__actions btn-row">
        <a class="btn btn--light" href="#kontakty">{hero.primaryCta}<Icon name="arrow-right" size={16} /></a>
        <a class="hero__secondary" href="#napravleniya">{hero.secondaryCta}<Icon name="arrow-down" size={14} /></a>
      </div>
      <p class="hero__microcopy">{hero.microcopy}</p>
      <dl class="hero__facts">
        {hero.facts.map((fact) => <div class="hero__fact"><dt class="hero__fact-label">{fact.label}</dt><dd class="hero__fact-value">{fact.value}</dd></div>)}
      </dl>
    </div>
    <div class="hero__visual">
      <Portrait priority />
      <div class="hero__signature"><span>{site.name}</span><small>Адвокат · реестровый номер {site.registryNumber}</small></div>
    </div>
  </div>
</section>
