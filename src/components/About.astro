---
import { site } from '../data/site';
import Portrait from './Portrait.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';
---
<section class="section section--paper home-about" id="ob-advokate" aria-labelledby="ob-advokate-title">
  <div class="container home-about__inner">
    <div class="home-about__visual" data-reveal><Portrait variant="about" /></div>
    <div class="home-about__content">
      <p class="eyebrow">Личная практика</p>
      <h2 id="ob-advokate-title">Юрий Анатольевич<br />Кочевинов</h2>
      <p class="home-about__lead">Опыт проверки, надзора и защиты — чтобы видеть уголовное дело с разных сторон.</p>
      <p>Работа в оперативных подразделениях и прокуратуре Мурманской области предшествовала адвокатской практике. Сейчас — уголовно-правовая защита из Твери, с участием в делах по всей России.</p>
      <dl class="home-about__facts">
        <div><dt>Юридическая практика</dt><dd>25 лет</dd></div>
        <div><dt>Статус адвоката</dt><dd>С 2023 года</dd></div>
        <div><dt>Реестровый номер</dt><dd>{site.registryNumber}</dd></div>
        <div><dt>Адвокатская палата</dt><dd>Мурманской области</dd></div>
      </dl>
      <a class="link-arrow" href={withBase('/ob-advokate/')}>Профессиональный путь и сведения<Icon name="arrow-right" size={16} /></a>
    </div>
  </div>
</section>
