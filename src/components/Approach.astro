---
const principles = [
  { title: 'Сначала — факты', text: 'Позиция появляется после изучения обстоятельств и документов, а не до знакомства с делом.' },
  { title: 'Прямой разговор', text: 'Перспективы обсуждаются честно, включая риски и неудобные сценарии.' },
  { title: 'Согласованный план', text: 'Объём помощи, стоимость и порядок взаимодействия фиксируются до начала работы.' },
];
---
<section class="section section--wine approach-compact" id="podhod" aria-labelledby="podhod-title">
  <div class="container">
    <div class="compact-head" data-reveal><div><p class="eyebrow">Подход к работе</p><h2 id="podhod-title">Не громкие обещания.<br /><em>Обоснованная позиция.</em></h2></div></div>
    <div class="approach-compact__grid">{principles.map((item, i) => <div data-reveal><span aria-hidden="true">0{i + 1}</span><h3>{item.title}</h3><p>{item.text}</p></div>)}</div>
  </div>
</section>
