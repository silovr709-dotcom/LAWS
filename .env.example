# Публичный адрес сайта (влияет на canonical, OG и sitemap)
PUBLIC_SITE_URL=https://kochevinov.ru

# Куда сохранять обращения (вне public/, права 0700)
LEADS_DIR=/var/lib/kochevinov/leads

# Опционально: webhook для уведомлений (Telegram-бот, CRM, n8n)
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# Версия текста согласия, которая фиксируется вместе с обращением
CONSENT_VERSION=1.0
