# Build-time URL. Replace this example with the owner's confirmed production domain.
PUBLIC_SITE_URL=https://example.org
# /LAWS for project Pages, / for a domain's root.
BASE_PATH=/
# Indexing requires the explicit value false after launch approval; Pages always stays noindex.
PUBLIC_NOINDEX=true

# Honest default: a direct VK link, with no form fields or message collection.
# mailto is available only if a confirmed email has been entered in src/data/site.ts.
PUBLIC_FORM_ENDPOINT=vk

# Optional Node intake. Enable only after storage, access, deletion and legal review are arranged.
# Both build AND runtime must use CONTACT_FORM_ENABLED=true. Static Pages cannot run this API.
CONTACT_FORM_ENABLED=false
# For enabled intake: PUBLIC_FORM_ENDPOINT=/api/contact at build time and an absolute private
# LEADS_DIR at build/runtime. Must be outside public/ and dist/client, with permissions 0700.
LEADS_DIR=

# Optional server-side copy/notification. Delivery failure does not undo a locally saved receipt.
# Check the processor, location and legal basis before enabling. Never use PUBLIC_ for secrets.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# Consent version is sourced from src/data/legal.ts; do not override it with environment variables.
#
# Приватная аналитика — по умолчанию выключена (пустые значения).
# Поддерживаются cookieless-варианты без идентификаторов: Plausible или Umami.
# Включайте только вместе с обновлением политики и уведомлением в интерфейсе.
# PUBLIC_ANALYTICS_PROVIDER=plausible   # или umami
# PUBLIC_ANALYTICS_DOMAIN=kochevinov.ru # для Umami — website-id
# PUBLIC_ANALYTICS_SRC=                 # необязательно: свой адрес скрипта / прокси
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=
